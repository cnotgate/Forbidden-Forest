# Environment variables for Doctor Tracker Backend
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# In Docker Compose, host is 'db': postgresql://postgres:postgrespassword@db:5432/doctortracker?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/doctortracker?schema=public"

# JWT Secrets (generate strong random keys in production)
JWT_ACCESS_SECRET="super-secret-doctor-access-key-change-in-production-2026"
JWT_REFRESH_SECRET="super-secret-doctor-refresh-key-change-in-production-2026"

# Frontend URL (for CORS and cookies)
FRONTEND_URL="http://localhost:5173"

