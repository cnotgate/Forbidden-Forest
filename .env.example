# ==========================================
# DOCTOR TRACKER - ENVIRONMENT VARIABLES
# Copy file ini menjadi .env pada root project di VPS:
# cp .env.example .env
# ==========================================

# 0. Docker Hub Username
DOCKERHUB_USER=username_dockerhub_anda

# 1. Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangKuat_2026
POSTGRES_DB=doctortracker

# 2. Keamanan Backend (JWT Secret)
# Buat string acak panjang (misal jalankan: openssl rand -base64 32)
JWT_ACCESS_SECRET=ganti-dengan-kunci-rahasia-access-token-minimal-32-karakter-acak
JWT_REFRESH_SECRET=ganti-dengan-kunci-rahasia-refresh-token-minimal-32-karakter-acak

# 3. URL Domain Frontend (Untuk CORS dan Cookie Policy)
# Ganti dengan domain Anda (contoh: https://tracker.namadomain.com atau http://IP_VPS_ANDA)
FRONTEND_URL=https://tracker.namadomain.com

# 4. Port Internal Localhost (Untuk di-reverse proxy oleh Nginx VPS)
FRONTEND_PORT=3080
BACKEND_PORT=5000

# 5. Google OAuth 2.0 (Opsional - biarkan kosong jika hanya email/password biasa)
# Dapatkan Client ID di https://console.cloud.google.com/apis/credentials
# Tambahkan Authorized JavaScript Origins: https://tracker.namadomain.com
VITE_GOOGLE_CLIENT_ID=
